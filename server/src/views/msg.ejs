<%- include('partials/header') %>
  <% const headerText=locals.header || "" ; %>
    <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-sm text-center">

      <h2 class="text-2xl font-bold mb-2 text-gray-800">
        <%= headerText || "" %>
      </h2>
      <p class="text-gray-600 mb-6">
        <%= locals.message %>
      </p>
      <% if(locals.link && locals.link.to && locals.link.text){ %>

        <a href="<%= locals.link.to%>"
          class="inline-block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-md transition-colors duration-200 text-center">
          <%= locals.link.text %>
        </a>

        <%}else if(locals.form && locals.form.action && locals.form.text){%>

          <form action="<%= locals.form.action %>" method="POST" class="space-y-4">
            <% if(locals.form.token){%>
              <input type="hidden" name="token" value="<%= locals.form.token %>">
              <%}%>
                <p>
                  <%=locals.form.text %>
                </p>
                <%- include('partials/submitButton', {text:locals.form.submitText || 'Send' }) %>
          </form>
          <%}%>
    </div>
    </body>

    </html>