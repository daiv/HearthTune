<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen">

  <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-sm text-center">
    <div class="mb-4 text-red-500 text-5xl">
      ⚠️
    </div>

    <h2 class="text-2xl font-bold mb-2 text-gray-800">Oops!</h2>

    <p class="text-gray-600 mb-6">
      <%= message || "Something went wrong, please try again later." %>
    </p>

    
    <% if (message==='token expired' ) { %>
      <form action="/request-new-link" method="POST" class="mb-4">
        
        <input type="visible" name="token" value="<%= token %>">
        <button type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 rounded-md transition-colors duration-200">
          Request new link
        </button>
      </form>
      <% } %>

  </div>

</body>

</html>