        <h2 class="text-2xl font-bold mb-6 text-gray-800 text-center">Set new Password</h2>
        <%- include('partials/passwordPair',{errors: locals.errors}) %>
        <%- include('partials/submitButton',{text:buttonText ||'Ok'}) %>
      </form>
    </div>
    <%- include('partials/footer') %>