<div>
  <label class="block text-sm font-medium text-gray-700">Password</label>
  <div class="relative mt-1">
    <input type="password" id="password" name="password"
      class="w-full p-2 pr-10 border rounded-md border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
    <button type="button" onclick="togglePassword('password', event)" tabindex="-1"
      class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-500 focus:outline-none">
      <i data-lucide="eye" class="icon-eye hidden w-5 h-5"></i>
      <i data-lucide="eye-off" class="icon-eye-off  w-5 h-5"></i>
    </button>
  </div>
  <% if (locals.errors?.password) { %>
    <p class="text-red-500 text-sm mt-1">
      <%= locals.errors.password %>
    </p>
    <% } %>
</div>
<div>
  <label class="block text-sm font-medium text-gray-700">Repeat password</label>
  <div class="relative mt-1">
    <input type="password" id="matchPassword" name="matchPassword"
      class="w-full p-2 pr-10 border rounded-md border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
    <button type="button" onclick="togglePassword('matchPassword', event)" tabindex="-1"
      class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-500 focus:outline-none">
      <i data-lucide="eye" class="icon-eye hidden w-5 h-5"></i>
      <i data-lucide="eye-off" class="icon-eye-off  w-5 h-5"></i>
    </button>
  </div>
  <% if (locals.errors?.matchPassword) { %>
    <p class="text-red-500 text-sm mt-1">
      <%= locals.errors?.matchPassword %>
    </p>
    <% } %>
</div>