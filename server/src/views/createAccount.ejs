<%- include('partials/header') %>
  <%- include('partials/toast') %>
    <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-sm">
      <form action="<%= action %>" method="POST" class="space-y-4">
        <input type="hidden" name="token" value="<%= token %>">
        <h2 class="text-2xl font-bold mb-6 text-gray-800 text-center">Create account</h2>
        <label class="block text-sm font-medium text-gray-700">Nick</label>
        <div class="relative mt-1">
          <input type="nick" id="nick" name="nick"
            class="w-full p-2 pr-10 border rounded-md border-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-500">
        </div>
        <% if (locals.errors?.nick) { %>
          <p class="text-red-500 text-sm mt-1">
            <%= locals.errors.nick %>
          </p>
          <% } %>
            <%- include('partials/passwordPair',{errors:locals.errors}) %>
              <%- include('partials/submitButton',{text:buttonText ||'Ok'}) %>
      </form>
    </div>
    <%- include('partials/footer') %>