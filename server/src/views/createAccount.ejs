<!-- src/views/register.ejs -->
<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8">
  <title>Create account</title>
  <!-- CDN de Tailwind -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen">
  <div class="bg-white p-8 rounded-lg shadow-md w-full max-w-sm">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">Create account</h2>
    <form action="/validation/<%= token %>" method="POST" class="space-y-4">

      <div>
        <label class="block text-sm font-medium text-gray-700">Password</label>
        <input type="password" name="password" required
          class="mt-1 w-full p-2 border rounded-md <%= errors && errors.password ? 'border-red-500' : 'border-gray-300' %>">

        <% if (errors && errors.password) { %>
          <p class="text-red-500 text-xs mt-1">
            <%= errors.password %>
          </p>
          <% } %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700">Confirm password</label>
        <input type="password" name="confirmPassword" required
          class="mt-1 w-full p-2 border rounded-md <%= errors && errors.match ? 'border-red-500' : 'border-gray-300' %>">
          <% if (errors && errors.match) { %>
          <p class="text-red-500 text-xs mt-1">
            <%= errors.match %>
          </p>
          <% } %>
      </div>

      <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded-md">
        Create Account
      </button>
      <input type="hidden" name="token" value="<%= token %>">
    </form>
  </div>
</body>

</html>