{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "rootDir": "..",
    "outDir": "./dist",
    "paths": {
      "@/common/*": [
        "./../common/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  }
}